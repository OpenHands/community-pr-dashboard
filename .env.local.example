# GitHub API Configuration
# Create a GitHub Personal Access Token with the following permissions:
# - read:org (to fetch organization members)
# - public_repo (to read public repository data)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Organization and Repository Configuration
# Comma-separated list of organizations to scan
ORGS=OpenHands

# Optional: Specific repositories to include (owner/repo format)
# If empty, will auto-discover repositories from the organizations
REPOS_INCLUDE=

# Optional: Repositories to exclude from auto-discovery
REPOS_EXCLUDE=

# SLA Configuration (in hours)
SLA_HOURS_FIRST_RESPONSE=24
SLA_HOURS_FIRST_REVIEW=48

# Cache Configuration
CACHE_TTL_SECONDS=120

# Neon Database Configuration
# Use the pooled Neon connection string for serverless/Vercel deployments.
DATABASE_URL=postgresql://dashboard_app:<password>@ep-example-pooler.region.aws.neon.tech/dashboard?sslmode=require
# Optional alias if you prefer not to use DATABASE_URL. DATABASE_URL takes precedence.
NEON_DATABASE_URL=

# Sync Configuration
# Protects cron/manual sync endpoints once those routes are enabled.
SYNC_CRON_SECRET=replace_with_a_long_random_secret
# Prevents page-load/manual refresh GitHub syncs from running more than once every 5 minutes globally.
DASHBOARD_SYNC_COOLDOWN_SECONDS=300
# Allows a crashed sync lock to be recovered after 10 minutes.
DASHBOARD_SYNC_LOCK_TIMEOUT_SECONDS=600

# Backfill Configuration
# Leave unset for full history; useful for local test runs.
BACKFILL_START_DATE=
# Leave unset for full backfill; useful as a safety cap for dry runs.
BACKFILL_MAX_PR_PAGES_PER_REPO=

# Optional: Maximum pages to fetch per repository (to control API usage)
MAX_PR_PAGES_PER_REPO=10

# Development Configuration
NODE_ENV=development